# Kavrigo local development environment — PLACEHOLDER VALUES ONLY.
# Copy to `.env` for local use. Never commit `.env`. Never put a production secret,
# exchange API key, or KMS capability in this file or in any AI coding tool context.

# ---------------------------------------------------------------------------
# Safety flags. Do not change these outside a gated live release (SPEC §47).
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false
DEFAULT_TRADING_MODE=paper
KAVRIGO_ENV=local

# ---------------------------------------------------------------------------
# Control plane
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Compose host port; override in the shell if Windows reserves the default range.
KAVRIGO_API_HOST_PORT=58000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Local infrastructure (docker compose defaults; not real credentials)
# ---------------------------------------------------------------------------
# The application connects as kavrigo_app: not a superuser, not the table owner, and
# without BYPASSRLS, so row-level security actually applies to it.
POSTGRES_DSN=postgresql+asyncpg://kavrigo_app:kavrigo_local_dev@localhost:55432/kavrigo
# Migrations run as the owning role, which can create tables and policies.
POSTGRES_MIGRATION_DSN=postgresql+asyncpg://kavrigo:kavrigo_local_dev@localhost:55432/kavrigo
CLICKHOUSE_URL=http://localhost:58123
CLICKHOUSE_USER=kavrigo
CLICKHOUSE_PASSWORD=kavrigo_local_dev
CLICKHOUSE_DATABASE=kavrigo
REDPANDA_BOOTSTRAP_SERVERS=localhost:59092
SCHEMA_REGISTRY_URL=http://localhost:58081
VALKEY_URL=redis://localhost:56379/0
TEMPORAL_ADDRESS=localhost:57233
TEMPORAL_NAMESPACE=default

# ---------------------------------------------------------------------------
# Identity. `dev` accepts unsigned `dev:<subject>` tokens and is refused by the
# application outside KAVRIGO_ENV=local. Use `jwks` everywhere else.
#
# Clerk issues standard JWTs, so it is configured here rather than coded against.
# Confirm the issuer, JWKS URL and claim names against current Clerk documentation
# before verifying a real token.
# ---------------------------------------------------------------------------
AUTH_PROVIDER=dev
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_ORGANIZATION_CLAIM=org_id
AUTH_MFA_CLAIM=mfa

CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ---------------------------------------------------------------------------
# Model gateway. Leave empty to use the deterministic mock model provider.
# ---------------------------------------------------------------------------
MODEL_GATEWAY_PROVIDER=mock
MODEL_GATEWAY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Data providers. Development keys only; commercial display rights are a launch
# blocker (SPEC §8.3). Tests must pass with all of these unset.
# ---------------------------------------------------------------------------
COINGECKO_API_KEY=
COINGLASS_API_KEY=
DUNE_API_KEY=

# ---------------------------------------------------------------------------
# Exchange credentials are NOT configured here. They belong exclusively to the
# isolated execution-credential service backed by AWS KMS + Secrets Manager
# (SPEC §15.2). No exchange key may ever be read by the API, the engine, the
# model gateway, or any LLM.
# ---------------------------------------------------------------------------
